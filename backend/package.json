{
    "name": "backend",
    "private": true,
    "version": "0.0.0",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "rimraf ./dist &&  tsc",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "format": "prettier --log-level warn --cache --write \"src/**/*.{js,ts,json}\""
    },
    "engines": {
        "node": ">=22.0.0 <23.0.0"
    },
    "dependencies": {
        "@trpc/server": "^11.28.0",
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "prettier": "^3.10.0",
        "rimraf": "^6.1.4",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
